{
  "manifest_version": 3,
  "name": "Delta Explorer",
  "version": "0.2.0",
  "description": "An AI helper for learning anything while you browse: expand any text inline, look things up, chat, explore pages on a canvas, and let it remember how you learn. Bring your own model.",
  "browser_specific_settings": {
    "gecko": {
      "id": "delta-ai-extension@naromil.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "clipboardWrite", "tabs", "alarms"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/markdown.js",
        "src/content/state.js",
        "src/content/anchor.js",
        "src/content/theme.js",
        "src/content/dom-utils.js",
        "src/content/persistence.js",
        "src/content/stream.js",
        "src/content/bubble.js",
        "src/content/prompt.js",
        "src/content/selection-bar.js",
        "src/content/rehydrate.js",
        "src/content/page-canvas.js",
        "src/content/init.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open the look-up"
    },
    "expand": {
      "suggested_key": {
        "default": "Ctrl+E"
      },
      "description": "Expand the selected text"
    },
    "expand-prompted": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Expand the selected text with your own question"
    },
    "open-canvas": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Explore the page on a canvas"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["canvas/canvas.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Delta Explorer look-up",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}

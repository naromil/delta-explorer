{
  "name": "delta-explorer",
  "desktopName": "com.deltaexplorer.desktop",
  "version": "0.6.13",
  "description": "A revolutionary AI helper for learning anything.",
  "main": "./out/main/index.js",
  "author": "naromil <nroamli@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/naromil/delta-explorer/",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/strip-usocket.mjs && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dbus-next": "^0.10.2",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.75",
    "@delta/core": "*",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ai": "^7.0.148",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "mdast-util-to-hast": "^13.2.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vite": "^7.2.6"
  }
}
